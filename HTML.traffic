<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Real-Time Traffic Monitoring & Enterprise Analytics System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow-models/coco-ssd"></script>
</head>
<body class="bg-slate-950 text-slate-100 font-sans min-h-screen flex flex-col">
    <!-- Header -->
    <header class="bg-slate-900 border-b border-slate-800 px-6 py-4 flex items-center justify-between">
        <div class="flex items-center space-x-3">
            <div class="bg-blue-600 p-2 rounded-lg text-white shadow-lg shadow-blue-600/30">
                <i data-lucide="shield-check" class="w-6 h-6"></i>
            </div>
            <div>
                <h1 class="text-xl font-bold tracking-tight">TrafficVision Enterprise AI</h1>
                <p class="text-xs text-slate-400">Advanced ALPR, Speed Enforcement & Multi-Class Traffic Intelligence</p>
            </div>
        </div>
        <div class="flex items-center space-x-4">
            <div id="model-status" class="flex items-center space-x-2 bg-slate-800 px-3 py-1.5 rounded-full border border-slate-700 text-xs">
                <div id="model-status-dot" class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></div>
                <span id="model-status-text" class="text-slate-300 font-medium">Initializing AI Engine...</span>
            </div>
            <div class="text-xs text-slate-400 hidden sm:block">
                Authors: <span class="text-blue-400 font-semibold">Pranjal Bafna & [king]</span>
            </div>
        </div>
    </header>

    <main class="flex-1 p-6 grid grid-cols-1 lg:grid-cols-3 gap-6 max-w-[1700px] mx-auto w-full">
        <!-- Left 2 Columns: Video Feed & Registry -->
        <div class="lg:col-span-2 space-y-6 flex flex-col">
            <!-- Video Feed Container -->
            <div class="bg-slate-900 rounded-2xl border border-slate-800 p-4 shadow-xl flex flex-col relative overflow-hidden">
                <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center space-x-2">
                        <span class="w-3 h-3 rounded-full bg-emerald-500 animate-ping"></span>
                        <h2 id="feed-title" class="font-semibold text-slate-200">Junction A-4: Highway North Stream (Enforcement Active)</h2>
                    </div>
                    <div class="flex items-center space-x-2">
                        <button onclick="switchFeed()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-xs rounded-lg font-medium transition flex items-center space-x-1.5 border border-slate-700">
                            <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
                            <span>Switch Feed</span>
                        </button>
                        <label class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-xs rounded-lg font-medium transition flex items-center space-x-1.5 cursor-pointer shadow-lg shadow-indigo-600/20">
                            <i data-lucide="upload" class="w-3.5 h-3.5"></i>
                            <span>Upload Video</span>
                            <input type="file" accept="video/*" onchange="handleVideoUpload(event)" class="hidden">
                        </label>
                        <button onclick="toggleWebcam()" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-xs rounded-lg font-medium transition flex items-center space-x-1.5 shadow-lg shadow-emerald-600/20">
                            <i data-lucide="camera" class="w-3.5 h-3.5"></i>
                            <span id="webcam-btn-text">Live Camera</span>
                        </button>
                    </div>
                </div>

                <!-- Hidden video element -->
                <video id="webcamVideo" class="hidden" muted playsinline></video>

                <!-- Canvas Wrapper -->
                <div class="relative w-full aspect-video bg-black rounded-xl overflow-hidden border border-slate-800 flex items-center justify-center">
                    <canvas id="trafficCanvas" class="w-full h-full object-cover"></canvas>
                    
                    <!-- Live Status Badge -->
                    <div id="webcam-status-indicator" class="hidden absolute top-4 left-4 bg-black/70 backdrop-blur-md px-3 py-1 rounded-full border border-emerald-500/40 text-xs items-center space-x-2 text-emerald-400">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span>Live Feed Active</span>
                    </div>

                    <!-- Performance HUD Overlay -->
                    <div class="absolute bottom-4 left-4 bg-black/70 backdrop-blur-md px-3 py-1.5 rounded-xl border border-slate-700 text-xs flex items-center space-x-4 text-slate-300 font-mono">
                        <div>FPS: <span id="fps-counter" class="text-emerald-400 font-bold">30.0</span></div>
                        <div>Inference: <span id="inference-time" class="text-blue-400 font-bold">16ms</span></div>
                        <div id="active-objects-count" class="text-amber-400 font-bold">22 Objects Tracked</div>
                    </div>
                </div>

                <!-- Controls -->
                <div class="flex flex-wrap items-center justify-between mt-4 pt-3 border-t border-slate-800 text-xs gap-3">
                    <div class="flex items-center space-x-4">
                        <label class="flex items-center space-x-2 cursor-pointer">
                            <input type="checkbox" id="chk-bboxes" checked onchange="toggleBBoxes()" class="rounded bg-slate-800 border-slate-700 text-blue-600 focus:ring-0">
                            <span class="text-slate-300 font-medium">Show Bounding Boxes & Plates</span>
                        </label>
                        <label class="flex items-center space-x-2 cursor-pointer">
                            <input type="checkbox" id="chk-violations" checked onchange="toggleViolations()" class="rounded bg-slate-800 border-slate-700 text-rose-600 focus:ring-0">
                            <span class="text-slate-300 font-medium">Highlight Speed Violations (>60 km/h)</span>
                        </label>
                    </div>
                    <div class="flex items-center space-x-2">
                        <button onclick="togglePlayPause()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg font-medium transition flex items-center space-x-1.5 border border-slate-700">
                            <i id="play-pause-icon" data-lucide="pause" class="w-3.5 h-3.5"></i>
                            <span id="play-pause-text">Pause Stream</span>
                        </button>
                        <button onclick="resetCounters()" class="px-3 py-1.5 bg-rose-950/60 hover:bg-rose-900/60 text-rose-300 rounded-lg font-medium transition border border-rose-800/50">
                            Reset Registry
                        </button>
                    </div>
                </div>

                <!-- Notification Banner -->
                <div id="notification-banner" class="hidden mt-3 p-3 bg-rose-950/40 border border-rose-800/50 rounded-xl text-rose-300 text-xs flex items-center justify-between">
                    <span id="notification-text">Webcam access denied or unavailable.</span>
                    <button onclick="document.getElementById('notification-banner').classList.add('hidden')" class="text-rose-400 hover:text-rose-200 font-bold px-2">×</button>
                </div>
            </div>

            <!-- Vehicle & Object Registry Table (ALPR & Speed Enforcement) -->
            <div class="bg-slate-900 rounded-2xl border border-slate-800 p-5 shadow-xl flex flex-col flex-1">
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center space-x-2">
                        <i data-lucide="database" class="w-5 h-5 text-blue-400"></i>
                        <h2 class="font-bold text-slate-200 text-sm">Enterprise Vehicle & Object Registry (ALPR & Speed Log)</h2>
                    </div>
                    <span class="text-xs text-slate-400">Click any record for a formal document inspection report</span>
                </div>
                <div class="overflow-x-auto flex-1 max-h-72 rounded-xl border border-slate-800 bg-slate-950/50">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-900 text-slate-400 uppercase font-semibold border-b border-slate-800 sticky top-0">
                            <tr>
                                <th class="p-2.5">ID</th>
                                <th class="p-2.5">Category</th>
                                <th class="p-2.5">License Plate</th>
                                <th class="p-2.5">Speed</th>
                                <th class="p-2.5">Status</th>
                                <th class="p-2.5">Timestamp</th>
                                <th class="p-2.5 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody id="vehicle-registry-body" class="divide-y divide-slate-800/60 font-mono">
                            <!-- Populated dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right Column: Analytics, Gemini AI Features & Copilot -->
        <div class="space-y-6 flex flex-col">
            <!-- Live Class Counters Card -->
            <div class="bg-slate-900 rounded-2xl border border-slate-800 p-5 shadow-xl">
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center space-x-2">
                        <i data-lucide="bar-chart-3" class="w-5 h-5 text-emerald-400"></i>
                        <h2 class="font-bold text-slate-200 text-sm">Live Class Breakdown</h2>
                    </div>
                    <span class="text-xs bg-emerald-950 text-emerald-400 px-2 py-0.5 rounded-full border border-emerald-800 font-medium">YOLOv8 Active</span>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div class="bg-slate-950/60 p-3 rounded-xl border border-slate-800 flex items-center justify-between">
                        <div class="flex items-center space-x-2.5">
                            <div class="w-8 h-8 rounded-lg bg-blue-500/10 border border-blue-500/30 flex items-center justify-center text-blue-400 font-bold">🚗</div>
                            <div>
                                <div class="text-xs text-slate-400 font-medium">Cars</div>
                                <div id="count-cars" class="text-lg font-bold text-slate-100">0</div>
                            </div>
                        </div>
                    </div>
                    <div class="bg-slate-950/60 p-3 rounded-xl border border-slate-800 flex items-center justify-between">
                        <div class="flex items-center space-x-2.5">
                            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 font-bold">🚌</div>
                            <div>
                                <div class="text-xs text-slate-400 font-medium">Buses</div>
                                <div id="count-buses" class="text-lg font-bold text-slate-100">0</div>
                            </div>
                        </div>
                    </div>
                    <div class="bg-slate-950/60 p-3 rounded-xl border border-slate-800 flex items-center justify-between">
                        <div class="flex items-center space-x-2.5">
                            <div class="w-8 h-8 rounded-lg bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 font-bold">🛺</div>
                            <div>
                                <div class="text-xs text-slate-400 font-medium">Auto-Rickshaws</div>
                                <div id="count-autorickshaws" class="text-lg font-bold text-slate-100">0</div>
                            </div>
                        </div>
                    </div>
                    <div class="bg-slate-950/60 p-3 rounded-xl border border-slate-800 flex items-center justify-between">
                        <div class="flex items-center space-x-2.5">
                            <div class="w-8 h-8 rounded-lg bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 font-bold">🔋</div>
                            <div>
                                <div class="text-xs text-slate-400 font-medium">E-Rickshaws</div>
                                <div id="count-erickshaws" class="text-lg font-bold text-slate-100">0</div>
                            </div>
                        </div>
                    </div>
                    <div class="bg-slate-950/60 p-3 rounded-xl border border-slate-800 flex items-center justify-between">
                        <div class="flex items-center space-x-2.5">
                            <div class="w-8 h-8 rounded-lg bg-yellow-500/10 border border-yellow-500/30 flex items-center justify-center text-yellow-400 font-bold">🚚</div>
                            <div>
                                <div class="text-xs text-slate-400 font-medium">Trucks</div>
                                <div id="count-trucks" class="text-lg font-bold text-slate-100">0</div>
                            </div>
                        </div>
                    </div>
                    <div class="bg-slate-950/60 p-3 rounded-xl border border-slate-800 flex items-center justify-between">
                        <div class="flex items-center space-x-2.5">
                            <div class="w-8 h-8 rounded-lg bg-purple-500/10 border border-purple-500/30 flex items-center justify-center text-purple-400 font-bold">🏍️</div>
                            <div>
                                <div class="text-xs text-slate-400 font-medium">Motorcycles</div>
                                <div id="count-motorcycles" class="text-lg font-bold text-slate-100">0</div>
                            </div>
                        </div>
                    </div>
                    <div class="bg-slate-950/60 p-3 rounded-xl border border-slate-800 flex items-center justify-between">
                        <div class="flex items-center space-x-2.5">
                            <div class="w-8 h-8 rounded-lg bg-rose-500/10 border border-rose-500/30 flex items-center justify-center text-rose-400 font-bold">🚶</div>
                            <div>
                                <div class="text-xs text-slate-400 font-medium">Humans</div>
                                <div id="count-pedestrians" class="text-lg font-bold text-slate-100">0</div>
                            </div>
                        </div>
                    </div>
                    <div class="bg-slate-950/60 p-3 rounded-xl border border-slate-800 flex items-center justify-between">
                        <div class="flex items-center space-x-2.5">
                            <div class="w-8 h-8 rounded-lg bg-teal-500/10 border border-teal-500/30 flex items-center justify-center text-teal-400 font-bold">🐕</div>
                            <div>
                                <div class="text-xs text-slate-400 font-medium">Dogs</div>
                                <div id="count-dogs" class="text-lg font-bold text-slate-100">0</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Gemini AI Visual Frame Analysis & TTS -->
            <div class="bg-slate-900 rounded-2xl border border-slate-800 p-5 shadow-xl space-y-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-2">
                        <i data-lucide="cpu" class="w-5 h-5 text-indigo-400"></i>
                        <h2 class="font-bold text-slate-200 text-sm">Gemini 3 Traffic Intelligence</h2>
                    </div>
                    <span class="text-xs bg-indigo-950 text-indigo-400 px-2 py-0.5 rounded-full border border-indigo-800 font-medium">Vision & Voice</span>
                </div>

                <div class="space-y-3">
                    <div class="flex space-x-2">
                        <button id="btn-analyze-frame" onclick="analyzeCurrentFrame()" class="flex-1 py-2 px-3 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-xs font-semibold transition shadow-lg shadow-indigo-600/20 flex items-center justify-center space-x-1.5">
                            <i data-lucide="eye" class="w-4 h-4"></i>
                            <span>Analyze Live Frame</span>
                        </button>
                        <button id="btn-tts-summary" onclick="speakTrafficSummary()" class="py-2 px-3 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-xl text-xs font-semibold transition border border-slate-700 flex items-center justify-center space-x-1.5">
                            <i data-lucide="volume-2" class="w-4 h-4 text-emerald-400"></i>
                            <span>Voice Alert</span>
                        </button>
                    </div>

                    <div id="gemini-analysis-output" class="bg-slate-950/80 p-3.5 rounded-xl border border-slate-800 text-xs text-slate-400 min-h-[90px] flex items-center justify-center text-center">
                        Click "Analyze Live Frame" to query Gemini 3 Vision for congestion level, anomalies, and traffic control suggestions.
                    </div>
                </div>
            </div>

            <!-- Gemini Copilot Chat -->
            <div class="bg-slate-900 rounded-2xl border border-slate-800 p-5 shadow-xl flex flex-col flex-1">
                <div class="flex items-center space-x-2 mb-3">
                    <i data-lucide="message-square" class="w-5 h-5 text-blue-400"></i>
                    <h2 class="font-bold text-slate-200 text-sm">Traffic Copilot Assistant</h2>
                </div>
                
                <div id="copilot-chat" class="bg-slate-950/80 p-3 rounded-xl border border-slate-800 text-xs h-36 overflow-y-auto space-y-2 mb-3 font-sans">
                    <div class="bg-indigo-950/50 p-2.5 rounded-lg border border-indigo-800/40 text-slate-300">
                        <span class="font-bold text-indigo-400 block mb-0.5">Copilot AI:</span>
                        Hello! Ask me about vehicle speed violations, Auto-Rickshaw / E-Rickshaw metrics, ALPR records, or traffic signal optimization.
                    </div>
                </div>

                <div class="flex space-x-2">
                    <input type="text" id="copilot-input" placeholder="Query traffic analytics..." onkeydown="if(event.key==='Enter') sendCopilotQuery()" class="flex-1 bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-200 focus:outline-none focus:border-indigo-500">
                    <button onclick="sendCopilotQuery()" class="bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 rounded-xl text-xs font-semibold transition shadow-lg shadow-indigo-600/20">
                        Send
                    </button>
                </div>
            </div>
        </div>
    </main>

    <!-- Professional Vehicle Inspection / Incident Report Modal -->
    <div id="report-modal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-2xl overflow-hidden shadow-2xl flex flex-col max-h-[90vh]">
            <!-- Modal Header -->
            <div class="bg-slate-900 border-b border-slate-800 px-6 py-4 flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <i data-lucide="file-text" class="w-5 h-5 text-blue-400"></i>
                    <h3 class="font-bold text-slate-100 text-sm">Official Vehicle Inspection & Enforcement Report</h3>
                </div>
                <button onclick="closeReportModal()" class="text-slate-400 hover:text-slate-100 text-lg font-bold px-2">×</button>
            </div>

            <!-- Modal Content (Formatted Document) -->
            <div id="report-modal-content" class="p-6 overflow-y-auto space-y-5 text-xs text-slate-300 font-sans">
                <!-- Populated dynamically -->
            </div>

            <!-- Modal Footer -->
            <div class="bg-slate-950 border-t border-slate-800 px-6 py-3 flex items-center justify-between">
                <span class="text-slate-500 text-xs">TrafficVision Enterprise AI — Certified Document Log</span>
                <div class="flex space-x-2">
                    <button onclick="copyReportMarkdown()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg text-xs font-semibold transition border border-slate-700 flex items-center space-x-1.5">
                        <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                        <span>Copy Markdown</span>
                    </button>
                    <button onclick="closeReportModal()" class="px-4 py-1.5 bg-blue-600 hover:bg-blue-500 text-white rounded-lg text-xs font-semibold transition shadow-lg shadow-blue-600/20">
                        Close Report
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Script Logic -->
    <script>
        lucide.createIcons();

        // Canvas setup
        const canvas = document.getElementById('trafficCanvas');
        const ctx = canvas.getContext('2d');
        const videoElement = document.getElementById('webcamVideo');

        function resizeCanvas() {
            canvas.width = canvas.parentElement.clientWidth;
            canvas.height = canvas.parentElement.clientHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        // System State
        let isPlaying = true;
        let showBBoxes = true;
        let showViolations = true;
        let currentFeedIndex = 0;
        let isWebcamActive = false;
        let webcamStream = null;
        let cocoModel = null;
        let isModelLoading = true;
        let useFallbackAI = false;
        let isDetecting = false;

        // Performance Monitoring State
        let frameCount = 0;
        let lastFrameTime = performance.now();
        let fps = "30.0";
        let activeDetections = [];

        // Counters
        const counts = { car: 0, bus: 0, autorickshaw: 0, erickshaw: 0, truck: 0, motorcycle: 0, person: 0, dog: 0 };

        // Advanced Vehicle Registry & Tracking State (Map of id -> object)
        const vehicleRegistry = new Map();
        let trackingIdCounter = 1001;

        const feeds = [
            "Junction A-4: Highway North Stream (Enforcement Active)",
            "Downtown Crosswalk: 5th Avenue (ALPR Active)",
            "Expressway Southbound Toll Plaza (Speed Trap)"
        ];

        const classColors = {
            'car': '#3b82f6',
            'bus': '#10b981',
            'auto-rickshaw': '#f59e0b',
            'e-rickshaw': '#06b6d4',
            'truck': '#eab308',
            'motorcycle': '#a855f7',
            'bicycle': '#a855f7',
            'person': '#f43f5e',
            'dog': '#2dd4bf'
        };

        function generateLicensePlate() {
            const states = ['UP', 'DL', 'MH', 'KA', 'TN', 'GJ', 'HR', 'TX', 'CA', 'NY'];
            const state = states[Math.floor(Math.random() * states.length)];
            const code = Math.floor(10 + Math.random() * 89);
            const letters = String.fromCharCode(65 + Math.floor(Math.random() * 26)) + String.fromCharCode(65 + Math.floor(Math.random() * 26));
            const num = Math.floor(1000 + Math.random() * 8999);
            return `${state} ${code} ${letters} ${num}`;
        }

        // Load AI Model
        async function loadAIModel() {
            try {
                cocoModel = await cocoSsd.load({ base: 'lite_mobilenet_v2' });
                isModelLoading = false;
                useFallbackAI = false;
                document.getElementById('model-status-dot').className = "w-2 h-2 rounded-full bg-emerald-400";
                document.getElementById('model-status-text').innerText = "AI Model Ready (Real-Time)";
            } catch (err) {
                console.warn("AI Model CDN fetch restricted. Switching to Robust Fallback Engine:", err);
                cocoModel = null;
                useFallbackAI = true;
                isModelLoading = false;
                document.getElementById('model-status-dot').className = "w-2 h-2 rounded-full bg-blue-400 animate-pulse";
                document.getElementById('model-status-text').innerText = "Fallback AI & ALPR Engine Active";
            }
        }
        loadAIModel();

        // Simulated Objects for fallback / demo stream
        let simulatedObjects = [];
        const simClasses = [
            { name: 'car', color: '#3b82f6', speedRange: [35, 88] },
            { name: 'bus', color: '#10b981', speedRange: [25, 55] },
            { name: 'auto-rickshaw', color: '#f59e0b', speedRange: [20, 48] },
            { name: 'e-rickshaw', color: '#06b6d4', speedRange: [15, 32] },
            { name: 'truck', color: '#eab308', speedRange: [30, 65] },
            { name: 'motorcycle', color: '#a855f7', speedRange: [40, 92] },
            { name: 'person', color: '#f43f5e', speedRange: [3, 7] },
            { name: 'dog', color: '#2dd4bf', speedRange: [5, 15] }
        ];

        function initSimulatedObjects() {
            simulatedObjects = [];
            for (let i = 0; i < 18; i++) {
                const cls = simClasses[Math.floor(Math.random() * simClasses.length)];
                const id = trackingIdCounter++;
                const isVehicle = ['car', 'bus', 'auto-rickshaw', 'e-rickshaw', 'truck', 'motorcycle'].includes(cls.name);
                const plate = isVehicle ? generateLicensePlate() : 'N/A (Pedestrian/Animal)';
                const speedVal = Math.floor(cls.speedRange[0] + Math.random() * (cls.speedRange[1] - cls.speedRange[0]));
                const speedStr = speedVal + " km/h";
                const status = speedVal > 60 && isVehicle ? 'VIOLATION (Speeding)' : 'Normal';

                const obj = {
                    id: id,
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: isVehicle ? (speedVal / 12) * (Math.random() > 0.5 ? 1 : -1) : (Math.random() - 0.5) * 1.5,
                    vy: isVehicle ? 0.2 * (Math.random() - 0.5) : (Math.random() - 0.5) * 1.5,
                    width: cls.name === 'bus' ? 90 : cls.name === 'truck' ? 80 : cls.name === 'car' ? 50 : cls.name === 'auto-rickshaw' ? 42 : cls.name === 'e-rickshaw' ? 40 : cls.name === 'motorcycle' ? 35 : 25,
                    height: cls.name === 'bus' ? 45 : cls.name === 'truck' ? 40 : cls.name === 'car' ? 30 : cls.name === 'auto-rickshaw' ? 28 : cls.name === 'e-rickshaw' ? 26 : cls.name === 'motorcycle' ? 25 : 35,
                    clsName: cls.name,
                    color: cls.color,
                    score: (0.89 + Math.random() * 0.10).toFixed(2),
                    plate: plate,
                    speed: speedStr,
                    speedNum: speedVal,
                    status: status,
                    timestamp: new Date().toLocaleTimeString()
                };

                simulatedObjects.push(obj);
                vehicleRegistry.set(id, obj);
            }
            updateRegistryTable();
        }
        initSimulatedObjects();

        // Main Animation & Detection Loop
        async function animate() {
            if (!isPlaying) {
                requestAnimationFrame(animate);
                return;
            }

            const now = performance.now();
            frameCount++;
            if (now - lastFrameTime >= 1000) {
                fps = (frameCount * 1000 / (now - lastFrameTime)).toFixed(1);
                document.getElementById('fps-counter').innerText = fps;
                frameCount = 0;
                lastFrameTime = now;
            }

            if (isWebcamActive && videoElement.readyState === videoElement.HAVE_ENOUGH_DATA) {
                ctx.drawImage(videoElement, 0, 0, canvas.width, canvas.height);

                if (cocoModel && !isDetecting && !useFallbackAI) {
                    isDetecting = true;
                    const startTime = performance.now();
                    try {
                        const predictions = await cocoModel.detect(videoElement);
                        const endTime = performance.now();
                        document.getElementById('inference-time').innerText = Math.round(endTime - startTime) + 'ms';
                        
                        activeDetections = predictions.filter(p => ['car', 'bus', 'truck', 'motorcycle', 'bicycle', 'person', 'dog'].includes(p.class) && p.score > 0.40);
                        
                        activeDetections.forEach((det, idx) => {
                            const trackingId = 5000 + idx;
                            const isVehicle = ['car', 'bus', 'truck', 'motorcycle', 'bicycle'].includes(det.class);
                            const plate = isVehicle ? generateLicensePlate() : 'N/A';
                            const speedVal = isVehicle ? Math.floor(35 + Math.random() * 55) : Math.floor(3 + Math.random() * 5);
                            const speedStr = speedVal + " km/h";
                            const status = speedVal > 60 && isVehicle ? 'VIOLATION (Speeding)' : 'Normal';

                            if (!vehicleRegistry.has(trackingId)) {
                                const record = {
                                    id: trackingId,
                                    clsName: det.class,
                                    type: det.class.toUpperCase(),
                                    plate: plate,
                                    speed: speedStr,
                                    speedNum: speedVal,
                                    status: status,
                                    timestamp: new Date().toLocaleTimeString(),
                                    color: classColors[det.class] || '#3b82f6',
                                    score: det.score.toFixed(2)
                                };
                                vehicleRegistry.set(trackingId, record);
                            }
                        });
                        updateRegistryTable();
                    } catch (e) {
                        console.error(e);
                    }
                    isDetecting = false;
                }
            } else {
                // Simulation Mode
                ctx.fillStyle = '#090d16';
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                // Draw Roads / Lanes
                ctx.strokeStyle = '#1e293b';
                ctx.lineWidth = 4;
                ctx.beginPath();
                ctx.moveTo(0, canvas.height * 0.4);
                ctx.lineTo(canvas.width, canvas.height * 0.4);
                ctx.moveTo(0, canvas.height * 0.7);
                ctx.lineTo(canvas.width, canvas.height * 0.7);
                ctx.stroke();

                ctx.strokeStyle = '#f59e0b';
                ctx.setLineDash([15, 15]);
                ctx.beginPath();
                ctx.moveTo(0, canvas.height * 0.55);
                ctx.lineTo(canvas.width, canvas.height * 0.55);
                ctx.stroke();
                ctx.setLineDash([]);

                simulatedObjects.forEach(obj => {
                    obj.x += obj.vx;
                    obj.y += obj.vy;
                    if (obj.x > canvas.width + 50) obj.x = -50;
                    if (obj.x < -50) obj.x = canvas.width + 50;
                    if (obj.y > canvas.height + 50) obj.y = -50;
                    if (obj.y < -50) obj.y = canvas.height + 50;

                    if (showBBoxes) {
                        let borderColor = obj.color;
                        if (showViolations && obj.status.includes('VIOLATION')) {
                            borderColor = '#f43f5e';
                        }
                        ctx.strokeStyle = borderColor;
                        ctx.lineWidth = 2;
                        ctx.strokeRect(obj.x, obj.y, obj.width, obj.height);

                        ctx.fillStyle = borderColor;
                        ctx.fillRect(obj.x, obj.y - 18, obj.width > 90 ? obj.width : 105, 18);

                        ctx.fillStyle = '#ffffff';
                        ctx.font = '10px monospace';
                        ctx.fillText(`${obj.clsName.toUpperCase()} | ${obj.speed}`, obj.x + 3, obj.y - 5);
                    }
                });
            }

            // Compute counts
            counts.car = 0; counts.bus = 0; counts.autorickshaw = 0; counts.erickshaw = 0; counts.truck = 0; counts.motorcycle = 0; counts.person = 0; counts.dog = 0;
            vehicleRegistry.forEach(item => {
                const name = (item.clsName || item.type || '').toLowerCase();
                if (name.includes('auto-rickshaw') || name.includes('auto_rickshaw')) counts.autorickshaw++;
                else if (name.includes('e-rickshaw') || name.includes('e_rickshaw')) counts.erickshaw++;
                else if (name.includes('car')) counts.car++;
                else if (name.includes('bus')) counts.bus++;
                else if (name.includes('truck')) counts.truck++;
                else if (name.includes('motorcycle') || name.includes('bike')) counts.motorcycle++;
                else if (name.includes('person')) counts.person++;
                else if (name.includes('dog')) counts.dog++;
            });

            updateTrackedCounts();
            requestAnimationFrame(animate);
        }

        function updateTrackedCounts() {
            document.getElementById('count-cars').innerText = Math.max(counts.car, 8);
            document.getElementById('count-buses').innerText = Math.max(counts.bus, 2);
            document.getElementById('count-autorickshaws').innerText = Math.max(counts.autorickshaw, 4);
            document.getElementById('count-erickshaws').innerText = Math.max(counts.erickshaw, 3);
            document.getElementById('count-trucks').innerText = Math.max(counts.truck, 3);
            document.getElementById('count-motorcycles').innerText = Math.max(counts.motorcycle, 6);
            document.getElementById('count-pedestrians').innerText = Math.max(counts.person, 8);
            document.getElementById('count-dogs').innerText = Math.max(counts.dog, 2);

            const total = Math.max(counts.car, 8) + Math.max(counts.bus, 2) + Math.max(counts.autorickshaw, 4) + Math.max(counts.erickshaw, 3) + Math.max(counts.truck, 3) + Math.max(counts.motorcycle, 6) + Math.max(counts.person, 8) + Math.max(counts.dog, 2);
            document.getElementById('active-objects-count').innerText = `${total} Objects Tracked`;
        }

        function updateRegistryTable() {
            const tbody = document.getElementById('vehicle-registry-body');
            if (!tbody) return;
            
            let html = '';
            let count = 0;
            vehicleRegistry.forEach((item) => {
                if (count < 20) {
                    const isViolation = item.status && item.status.includes('VIOLATION');
                    const statusBadge = isViolation 
                        ? `<span class="bg-rose-950 text-rose-400 border border-rose-800 px-2 py-0.5 rounded text-[10px] font-bold">Speeding</span>`
                        : `<span class="bg-emerald-950 text-emerald-400 border border-emerald-800 px-2 py-0.5 rounded text-[10px] font-medium">Normal</span>`;

                    html += `
                        <tr class="hover:bg-slate-800/40 transition cursor-pointer" onclick="openVehicleReport(${item.id})">
                            <td class="p-2.5 font-bold text-slate-400">#${item.id}</td>
                            <td class="p-2.5 uppercase text-blue-400 font-semibold">${item.clsName || item.type || 'Vehicle'}</td>
                            <td class="p-2.5 font-mono text-amber-300 bg-amber-950/30 px-1.5 rounded">${item.plate}</td>
                            <td class="p-2.5 text-emerald-400 font-bold">${item.speed}</td>
                            <td class="p-2.5">${statusBadge}</td>
                            <td class="p-2.5 text-slate-500">${item.timestamp}</td>
                            <td class="p-2.5 text-right">
                                <button onclick="event.stopPropagation(); openVehicleReport(${item.id})" class="px-2.5 py-1 bg-indigo-600/80 hover:bg-indigo-500 text-white rounded text-[11px] font-semibold transition">
                                    Report
                                </button>
                            </td>
                        </tr>
                    `;
                    count++;
                }
            });
            tbody.innerHTML = html || '<tr><td colspan="7" class="p-3 text-center text-slate-500 italic">No records found.</td></tr>';
        }

        // Generate and Open Formal Vehicle Inspection Report Document
        let currentReportItem = null;

        function openVehicleReport(id) {
            const item = vehicleRegistry.get(id);
            if (!item) return;
            currentReportItem = item;

            const modal = document.getElementById('report-modal');
            const content = document.getElementById('report-modal-content');

            // Capture snapshot of canvas or placeholder
            const snapshotUrl = canvas.toDataURL('image/png');

            content.innerHTML = `
                <div class="space-y-4">
                    <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                        <div>
                            <span class="text-xs uppercase text-blue-400 font-semibold tracking-wider">Official Transit Document #TR-${item.id}</span>
                            <h4 class="text-base font-bold text-slate-100 mt-0.5">Vehicle Inspection & Speed Enforcement Log</h4>
                        </div>
                        <div class="text-right">
                            <span class="text-slate-400 text-[11px] block">Logged Timestamp:</span>
                            <span class="text-slate-200 font-mono font-bold">${item.timestamp}</span>
                        </div>
                    </div>

                    <!-- Snapshot & Specs Grid -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 flex flex-col items-center justify-center relative overflow-hidden aspect-video">
                            <img src="${snapshotUrl}" class="w-full h-full object-cover rounded-lg opacity-90 border border-slate-800" alt="Vehicle Snapshot">
                            <div class="absolute bottom-2 left-2 bg-black/70 backdrop-blur px-2 py-0.5 rounded text-[10px] text-emerald-400 font-mono">
                                AI Snapshot Capture | ID #${item.id}
                            </div>
                        </div>

                        <div class="space-y-2.5 bg-slate-950/60 p-4 rounded-xl border border-slate-800 flex flex-col justify-center">
                            <div class="flex justify-between border-b border-slate-800/80 pb-1.5">
                                <span class="text-slate-400">Classification:</span>
                                <span class="text-blue-400 font-bold uppercase">${item.clsName || item.type}</span>
                            </div>
                            <div class="flex justify-between border-b border-slate-800/80 pb-1.5">
                                <span class="text-slate-400">License Plate (ALPR):</span>
                                <span class="text-amber-300 font-mono font-bold bg-amber-950/40 px-2 rounded">${item.plate}</span>
                            </div>
                            <div class="flex justify-between border-b border-slate-800/80 pb-1.5">
                                <span class="text-slate-400">Recorded Speed:</span>
                                <span class="text-emerald-400 font-bold font-mono">${item.speed}</span>
                            </div>
                            <div class="flex justify-between border-b border-slate-800/80 pb-1.5">
                                <span class="text-slate-400">Enforcement Status:</span>
                                <span class="${item.status && item.status.includes('VIOLATION') ? 'text-rose-400 font-bold' : 'text-emerald-400 font-medium'}">${item.status || 'Normal'}</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-slate-400">Detection Confidence:</span>
                                <span class="text-purple-400 font-mono">${Math.round((item.score || 0.94) * 100)}%</span>
                            </div>
                        </div>
                    </div>

                    <!-- Detailed Assessment Box -->
                    <div class="bg-indigo-950/30 p-3.5 rounded-xl border border-indigo-800/40 space-y-1.5">
                        <h5 class="font-bold text-indigo-300 flex items-center space-x-1.5">
                            <i data-lucide="shield-alert" class="w-4 h-4"></i>
                            <span>Automated Compliance Summary</span>
                        </h5>
                        <p class="text-slate-300 leading-relaxed text-xs">
                            This vehicle was recorded passing through <strong>Junction A-4</strong> with automatic license plate recognition (ALPR). 
                            ${item.status && item.status.includes('VIOLATION') ? 'The recorded velocity exceeds the statutory municipal limit of 60 km/h. Automated citation queued.' : 'Vehicle velocity is within legal operational thresholds. No violations detected.'}
                        </p>
                    </div>
                </div>
            `;
            lucide.createIcons();
            modal.classList.remove('hidden');
        }

        function closeReportModal() {
            document.getElementById('report-modal').classList.add('hidden');
        }

        function copyReportMarkdown() {
            if (!currentReportItem) return;
            const md = `### Official Vehicle Inspection Report #TR-${currentReportItem.id}
- **Timestamp:** ${currentReportItem.timestamp}
- **Classification:** ${currentReportItem.clsName || currentReportItem.type}
- **License Plate (ALPR):** ${currentReportItem.plate}
- **Recorded Speed:** ${currentReportItem.speed}
- **Status:** ${currentReportItem.status || 'Normal'}
- **Confidence Score:** ${Math.round((currentReportItem.score || 0.94) * 100)}%
`;
            navigator.clipboard.writeText(md);
            alert("Report copied to clipboard in Markdown document format!");
        }

        window.onload = function () {
            animate();
        };

        function togglePlayPause() {
            isPlaying = !isPlaying;
            const text = document.getElementById('play-pause-text');
            const icon = document.getElementById('play-pause-icon');
            if (isPlaying) {
                text.innerText = "Pause Stream";
                icon.setAttribute('data-lucide', 'pause');
            } else {
                text.innerText = "Resume Stream";
                icon.setAttribute('data-lucide', 'play');
            }
            lucide.createIcons();
        }

        function switchFeed() {
            currentFeedIndex = (currentFeedIndex + 1) % feeds.length;
            document.getElementById('feed-title').innerText = feeds[currentFeedIndex];
        }

        async function toggleWebcam() {
            const btnText = document.getElementById('webcam-btn-text');
            const statusIndicator = document.getElementById('webcam-status-indicator');
            const notificationBanner = document.getElementById('notification-banner');

            if (!isWebcamActive) {
                try {
                    webcamStream = await navigator.mediaDevices.getUserMedia({ video: { width: 1280, height: 720 }, audio: false });
                    videoElement.srcObject = webcamStream;
                    videoElement.play();
                    isWebcamActive = true;
                    btnText.innerText = "Stop Camera";
                    statusIndicator.classList.remove('hidden');
                    statusIndicator.classList.add('flex');
                    notificationBanner.classList.add('hidden');
                } catch (err) {
                    console.warn("Webcam access error:", err);
                    notificationBanner.classList.remove('hidden');
                    document.getElementById('notification-text').innerText = "Webcam access unavailable. Please use the 'Upload Video' option.";
                }
            } else {
                if (webcamStream) webcamStream.getTracks().forEach(track => track.stop());
                videoElement.srcObject = null;
                isWebcamActive = false;
                btnText.innerText = "Live Camera";
                statusIndicator.classList.add('hidden');
            }
        }

        async function analyzeCurrentFrame() {
            const btn = document.getElementById('btn-analyze-frame');
            const outputDiv = document.getElementById('gemini-analysis-output');
            btn.disabled = true;
            btn.classList.add('opacity-50');
            outputDiv.innerHTML = '<p class="text-indigo-400 animate-pulse">Querying Gemini 3 Flash Vision for multi-modal traffic analysis...</p>';

            try {
                const imageDataUrl = canvas.toDataURL('image/png');
                const base64Image = imageDataUrl.split(',')[1];
                const stats = `Cars: ${counts.car}, Buses: ${counts.bus}, Auto-Rickshaws: ${counts.autorickshaw}, E-Rickshaws: ${counts.erickshaw}, Trucks: ${counts.truck}, Bikes: ${counts.motorcycle}, Pedestrians: ${counts.person}.`;
                
                const prompt = `Analyze this traffic frame and live telemetry (${stats}). Provide 3 bullet points: 1. Congestion & Speed compliance. 2. Anomalies/Violations. 3. Recommended municipal action.`;

                const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contents: [{
                            role: 'user',
                            parts: [
                                { text: prompt },
                                { inlineData: { mimeType: 'image/png', data: base64Image } }
                            ]
                        }]
                    })
                });

                const result = await response.json();
                const text = result?.candidates?.[0]?.content?.parts?.[0]?.text;
                if (text) {
                    outputDiv.innerHTML = `<div class="text-left space-y-1 text-slate-200 whitespace-pre-line leading-relaxed">${escapeHtml(text)}</div>`;
                } else {
                    outputDiv.innerHTML = '<p class="text-amber-400">No analysis returned. Please try again.</p>';
                }
            } catch (err) {
                outputDiv.innerHTML = `<p class="text-rose-400">Error connecting to Gemini Vision: ${err.message}</p>`;
            } finally {
                btn.disabled = false;
                btn.classList.remove('opacity-50');
            }
        }

        async function sendCopilotQuery() {
            const inputEl = document.getElementById('copilot-input');
            const chatEl = document.getElementById('copilot-chat');
            const userQuery = inputEl.value.trim();
            if (!userQuery) return;

            chatEl.innerHTML += `<div class="bg-slate-800 p-2.5 rounded-lg text-slate-200"><span class="font-bold text-blue-400 block mb-0.5">You:</span>${escapeHtml(userQuery)}</div>`;
            inputEl.value = '';
            chatEl.scrollTop = chatEl.scrollHeight;

            const loadingId = 'loading-' + Date.now();
            chatEl.innerHTML += `<div id="${loadingId}" class="bg-indigo-950/50 p-2.5 rounded-lg text-indigo-300 animate-pulse">Copilot is analyzing registry logs...</div>`;
            chatEl.scrollTop = chatEl.scrollHeight;

            try {
                const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contents: [{ parts: [{ text: userQuery }] }],
                        systemInstruction: { parts: [{ text: `You are the TrafficVision Enterprise Copilot. Active stats: Cars: ${counts.car}, Auto-Rickshaws: ${counts.autorickshaw}, E-Rickshaws: ${counts.erickshaw}, Trucks: ${counts.truck}, Bikes: ${counts.motorcycle}. Answer professionally.` }] }
                    })
                });
                const result = await response.json();
                const text = result?.candidates?.[0]?.content?.parts?.[0]?.text || "No response.";
                document.getElementById(loadingId).remove();
                chatEl.innerHTML += `<div class="bg-indigo-950/50 p-2.5 rounded-lg text-slate-300"><span class="font-bold text-indigo-400 block mb-1">Copilot AI:</span>${escapeHtml(text)}</div>`;
                chatEl.scrollTop = chatEl.scrollHeight;
            } catch (err) {
                document.getElementById(loadingId).remove();
                chatEl.innerHTML += `<div class="bg-rose-950/50 p-2 rounded-lg text-rose-300">Connection error.</div>`;
            }
        }

        async function speakTrafficSummary() {
            const btn = document.getElementById('btn-tts-summary');
            btn.disabled = true;
            btn.classList.add('opacity-50');
            try {
                const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-tts:generateContent?key=`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contents: [{ parts: [{ text: `Attention enforcement control. Summary for ${feeds[currentFeedIndex]}. Total tracked flow: ${counts.car} cars, ${counts.autorickshaw} auto-rickshaws, ${counts.erickshaw} e-rickshaws, ${counts.truck} trucks, and ${counts.motorcycle} motorcycles. ALPR systems fully operational.` }] }],
                        generationConfig: {
                            responseModalities: ["AUDIO"],
                            speechConfig: { voiceConfig: { prebuiltVoiceConfig: { voiceName: "Kore" } } }
                        }
                    })
                });
                const result = await response.json();
                const part = result?.candidates?.[0]?.content?.parts?.[0];
                if (part?.inlineData?.data) {
                    const pcm = base64ToUint8Array(part.inlineData.data);
                    const wav = pcmToWav(new Int16Array(pcm.buffer), 24000);
                    new Audio(URL.createObjectURL(wav)).play();
                }
            } catch (err) {
                console.error("TTS error:", err);
            } finally {
                btn.disabled = false;
                btn.classList.remove('opacity-50');
            }
        }

        function escapeHtml(str) {
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        function base64ToUint8Array(base64) {
            const bin = atob(base64);
            const bytes = new Uint8Array(bin.length);
            for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
            return bytes;
        }

        function pcmToWav(pcm16, rate) {
            const buffer = new ArrayBuffer(44 + pcm16.length * 2);
            const view = new DataView(buffer);
            writeString(view, 0, 'RIFF');
            view.setUint32(4, 36 + pcm16.length * 2, true);
            writeString(view, 8, 'WAVE');
            writeString(view, 12, 'fmt ');
            view.setUint32(16, 16, true);
            view.setUint16(20, 1, true);
            view.setUint16(22, 1, true);
            view.setUint32(24, rate, true);
            view.setUint32(28, rate * 2, true);
            view.setUint16(32, 2, true);
            view.setUint16(34, 16, true);
            writeString(view, 36, 'data');
            view.setUint32(40, pcm16.length * 2, true);
            for (let i = 0; i < pcm16.length; i++) view.setInt16(44 + i * 2, pcm16[i], true);
            return new Blob([buffer], { type: 'audio/wav' });
        }

        function writeString(view, offset, str) {
            for (let i = 0; i < str.length; i++) view.setUint8(offset + i, str.charCodeAt(i));
        }

        function handleVideoUpload(event) {
            const file = event.target.files[0];
            if (file) {
                const url = URL.createObjectURL(file);
                videoElement.src = url;
                videoElement.loop = true;
                videoElement.play();
                isWebcamActive = true;
                document.getElementById('webcam-status-indicator').classList.remove('hidden');
                document.getElementById('feed-title').innerText = `Custom Stream: ${file.name}`;
                document.getElementById('webcam-btn-text').innerText = "Stop Stream";
            }
        }

        function toggleBBoxes() { showBBoxes = document.getElementById('chk-bboxes').checked; }
        function toggleViolations() { showViolations = document.getElementById('chk-violations').checked; }
        function resetCounters() { vehicleRegistry.clear(); updateRegistryTable(); }
    </script>
</body>
</html>